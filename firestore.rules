rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 전용 입시 데이터 동기화 규칙 (화이트리스트 인증된 가족 구성원 읽기/쓰기 허용)
    match /families/{familyId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
